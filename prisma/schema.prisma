generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  FEEDER_DRIVER
  TRANSIT_DRIVER
  ADMIN
}

enum OrderStatus {
  SEARCHING
  ACCEPTED
  PICKED_UP
  COMPLETED
  CANCELLED
}

model User {
  id         String  @id @default(cuid())
  name       String
  email      String  @unique
  password   String
  role       Role    @default(PASSENGER)
  isOnline   Boolean @default(false)
  currentLat Float?
  currentLng Float?

  transitFleet TransitVehicle?
  ordersMade   FeederOrder[]   @relation("PassengerOrders")
  ordersTaken  FeederOrder[]   @relation("DriverOrders")
}

model Route {
  id       String           @id @default(cuid())
  code     String           @unique
  name     String
  colorHex String           @default("#2563EB")
  stops    Halte[]
  vehicles TransitVehicle[]
}

model Halte {
  id         String @id @default(cuid())
  name       String
  lat        Float
  lng        Float
  orderIndex Int
  routeId    String
  route      Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  feederDrops FeederOrder[]
}

model TransitVehicle {
  id             String   @id @default(cuid())
  plateNumber    String   @unique
  vehicleType    String   // "BUS", "ANGKOT", "SHUTTLE"
  maxSeats       Int      @default(12)
  occupiedSeats  Int      @default(0)
  currentLat     Float
  currentLng     Float
  currentStopIdx Int      @default(0)
  isActive       Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  routeId  String
  route    Route  @relation(fields: [routeId], references: [id])
  driverId String @unique
  driver   User   @relation(fields: [driverId], references: [id])
}

model FeederOrder {
  id         String      @id @default(cuid())
  pickupLat  Float
  pickupLng  Float
  pickupNote String?
  distanceKm Float
  price      Int
  status     OrderStatus @default(SEARCHING)
  createdAt  DateTime    @default(now())

  passengerId   String
  passenger     User   @relation("PassengerOrders", fields: [passengerId], references: [id])
  driverId      String?
  driver        User?  @relation("DriverOrders", fields: [driverId], references: [id])
  targetHalteId String
  targetHalte   Halte  @relation(fields: [targetHalteId], references: [id])
}
